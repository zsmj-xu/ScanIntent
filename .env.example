# Replace the project ID and password before starting Compose.
SCANINTENT_PROJECT_ID=your-langfuse-project-id
SCANINTENT_CLICKHOUSE_URL=http://127.0.0.1:18124
SCANINTENT_CLICKHOUSE_DATABASE=scanintent
SCANINTENT_CLICKHOUSE_USER=scanintent
SCANINTENT_CLICKHOUSE_PASSWORD=replace-with-a-long-random-password

SOURCE_CLICKHOUSE_HOST=your-source-host
SOURCE_CLICKHOUSE_PORT=8123
SOURCE_CLICKHOUSE_DATABASE=langfuse
SOURCE_CLICKHOUSE_USER=your-readonly-user
SOURCE_CLICKHOUSE_PASSWORD=your-source-password
SOURCE_CLICKHOUSE_SECURE=0
